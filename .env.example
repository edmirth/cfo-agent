# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Tripletex MCP server
TRIPLETEX_MCP_URL=https://mcp.tripletex.no
# OAuth / service token the MCP server accepts. Leave blank only if the
# server allows unauthenticated connections (it does not, in production).
TRIPLETEX_MCP_TOKEN=

# Company shown in the UI header
COMPANY_NAME=Ullensaker Renholdsteknikk AS

# Model settings
CFO_MODEL=claude-opus-5
CFO_EFFORT=high
