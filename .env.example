# ============================================================
#  1. ANTHROPIC-NØKKEL   (console.anthropic.com)
# ============================================================

ANTHROPIC_API_KEY=


# ============================================================
#  2. TRIPLETEX
#     Settes automatisk av:  ./.venv/bin/python scripts/oauth_login.py
#     Refresh-tokenet utløper ikke — engangsjobb.
# ============================================================

TRIPLETEX_CLIENT_ID=
TRIPLETEX_REFRESH_TOKEN=


# ============================================================
#  3. INNLOGGING   (supabase.com — se «Innlogging» i README)
#     Serveren starter ikke uten disse.
# ============================================================

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Daglig leders e-post. Flere skilles med komma.
CFO_OWNER_EMAIL=
# Bare for prosjekter på den gamle delte nøkkelen:
# SUPABASE_JWT_SECRET=
# CFO_AUTH=off kjører appen uten innlogging, åpen for alle som når porten.


# ============================================================
#  4. E-POST   (resend.com — se «E-post» i README)
#     Mandagsbrevet sendes hit hver mandag. Uten nøkkel sendes det ikke,
#     og forsiden sier fra.
# ============================================================

RESEND_API_KEY=
# Avsender. arvaka.no er verifisert i Resend, så Render sender som
# cfo@arvaka.no. Uten denne linja brukes Resends testadresse, som bare
# leverer til e-posten Resend-kontoen ble laget med.
# CFO_MAIL_FROM=Arvaka <cfo@arvaka.no>


# ============================================================
#  5. SIKKERHETSKOPI   (se «Sikkerhetskopi» i docs/hosting.md)
#     Hver natt lagres en kopi på disken. Med disse sendes den også kryptert
#     til Supabase Storage. På Render må de være satt; på Mac-en er det valgfritt.
# ============================================================

# Lag med: ./.venv/bin/python scripts/backup.py key  — og ta vare på den.
# CFO_BACKUP_KEY=
# service_role-nøkkelen fra Supabase-prosjektet kopiene skal ligge i.
# SUPABASE_SERVICE_KEY=
# Hvis kopiene ligger i et annet Supabase-prosjekt enn innloggingen:
# CFO_BACKUP_SUPABASE_URL=
# CFO_BACKUP_BUCKET=backups
# CFO_BACKUP_AT=02:00


# ============================================================
#  6. INNSTILLINGER - disse trenger du ikke røre
# ============================================================

COMPANY_NAME=Ullensaker Renholdsteknikk AS
CFO_MODEL=claude-opus-5
CFO_EFFORT=high

# Morgenkjøringen: hver virkedag kl 07:00 norsk tid, mens serveren går.
# CFO_SCHEDULER=off slår den av.
CFO_SCHEDULER=on
CFO_MORNING_AT=07:00
CFO_TIMEZONE=Europe/Oslo
