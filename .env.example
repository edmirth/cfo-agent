# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Tripletex REST API tokens.
#   Consumer token: one per integration.
#     - Own company only? None needed — generate a company API token instead
#       (Company > API tokens in Tripletex) and paste it as the EMPLOYEE token.
#     - Selling to others? Apply at developer.tripletex.no, 2-3 weeks.
#   Employee token: created per customer under Company > API tokens.
TRIPLETEX_CONSUMER_TOKEN=
TRIPLETEX_EMPLOYEE_TOKEN=

# Company shown in the UI header
COMPANY_NAME=Ullensaker Renholdsteknikk AS

# Model settings
CFO_MODEL=claude-opus-5
CFO_EFFORT=high
